{
  "name": "sightcheck-prototype",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "node scripts/prepare-ocr.mjs && vite build && vite build --config vite.api.config.js",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "demo": "node dist/server/demo.mjs",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "test": "node --test tests/*.test.js experiments/vlm-spike/adapter.test.mjs",
    "test:vlm": "node experiments/vlm-spike/run-spike.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "@tesseract.js-data/eng": "1.0.0"
  }
}
