{
  "name": "sightcheck-prototype",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "node scripts/prepare-ocr.mjs && vite build && vite build --config vite.api.config.js",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "demo": "node dist/server/demo.mjs",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "test": "node --test tests/*.test.js experiments/vlm-spike/adapter.test.mjs",
    "test:vlm": "node experiments/vlm-spike/run-spike.mjs",
    "dev:showcase": "vite --config vite.showcase.config.js --host 127.0.0.1 --port 4192 --strictPort",
    "build:showcase": "vite build --config vite.showcase.config.js",
    "build:html": "vite build --config vite.showcase.config.js && node scripts/export-showcase.mjs",
    "preview:showcase": "vite preview --config vite.showcase.config.js --host 127.0.0.1 --port 4192 --strictPort"
  },
  "dependencies": {
    "lenis": "1.3.26",
    "motion": "14.0.0",
    "tesseract.js": "7.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "vite": "8.3.1"
  }
}
